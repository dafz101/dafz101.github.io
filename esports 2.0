<!DOCTYPE html>
<html >
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <link rel="stylesheet" href="css/site.css">

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
    rel="stylesheet"
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
    crossorigin="anonymous"
  >

  <title>Esports Teams</title>
</head>

<body>

  <div class="container py-4">

    <div class="row">
      <div class="col">
        <h1>Esports Teams</h1>
        <hr class="featurette-divider">
      </div>
    </div>

    <div class="row g-4">

      <!-- Team Liquid -->
      <div class="col-md-4">
        <div class="card h-100 shadow-sm">
          <div class="card-body">
            <h2 class="card-title">Team Liquid</h2>

            <p class="card-text">
              Team Liquid is one of the world's most well-known esports
              organisations, competing across games such as League of Legends,
              Counter-Strike and Dota 2.
            </p>

            <p><strong>Wins:</strong> 18</p>
            <p><strong>Losses:</strong> 7</p>
            <p><strong>Win Rate:</strong> 72%</p>

            <a href="#" class="btn btn-primary">View Team</a>
          </div>
        </div>
      </div>

      <!-- Fnatic -->
      <div class="col-md-4">
        <div class="card h-100 shadow-sm">
          <div class="card-body">
            <h2 class="card-title">Fnatic</h2>

            <p class="card-text">
              Fnatic is a European esports organisation known for competing
              at the highest level in games including League of Legends,
              Counter-Strike and VALORANT.
            </p>

            <p><strong>Wins:</strong> 20</p>
            <p><strong>Losses:</strong> 5</p>
            <p><strong>Win Rate:</strong> 80%</p>

            <a href="#" class="btn btn-primary">View Team</a>
          </div>
        </div>
      </div>

      <!-- G2 Esports -->
      <div class="col-md-4">
        <div class="card h-100 shadow-sm">
          <div class="card-body">
            <h2 class="card-title">G2 Esports</h2>

            <p class="card-text">
              G2 Esports is a European esports organisation that competes
              across several major competitive games and is known for its
              successful international teams.
            </p>

            <p><strong>Wins:</strong> 22</p>
            <p><strong>Losses:</strong> 8</p>
            <p><strong>Win Rate:</strong> 73%</p>

            <a href="#" class="btn btn-primary">View Team</a>
          </div>
        </div>
      </div>

      <!-- Natus Vincere -->
      <div class="col-md-4">
        <div class="card h-100 shadow-sm">
          <div class="card-body">
            <h2 class="card-title">Natus Vincere</h2>

            <p class="card-text">
              Natus Vincere, commonly known as NAVI, is a Ukrainian esports
              organisation with teams competing in several major esports titles.
            </p>

            <p><strong>Wins:</strong> 19</p>
            <p><strong>Losses:</strong> 6</p>
            <p><strong>Win Rate:</strong> 76%</p>

            <a href="#" class="btn btn-primary">View Team</a>
          </div>
        </div>
      </div>

      <!-- T1 -->
      <div class="col-md-4">
        <div class="card h-100 shadow-sm">
          <div class="card-body">
            <h2 class="card-title">T1</h2>

            <p class="card-text">
              T1 is a South Korean esports organisation particularly famous
              for its League of Legends team and its history of international
              tournament success.
            </p>

            <p><strong>Wins:</strong> 24</p>
            <p><strong>Losses:</strong> 6</p>
            <p><strong>Win Rate:</strong> 80%</p>

            <a href="#" class="btn btn-primary">View Team</a>
          </div>
        </div>
      </div>

      <!-- Cloud9 -->
      <div class="col-md-4">
        <div class="card h-100 shadow-sm">
          <div class="card-body">
            <h2 class="card-title">Cloud9</h2>

            <p class="card-text">
              Cloud9 is a North American esports organisation competing in
              multiple games and is one of the best-known esports brands in
              North America.
            </p>

            <p><strong>Wins:</strong> 16</p>
            <p><strong>Losses:</strong> 9</p>
            <p><strong>Win Rate:</strong> 64%</p>

            <a href="butten" class="btn btn-primary">View Team</a>
          </div>
        </div>
      </div>

    </div>
  </div>



</body>
</html>
